{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["../../src/*"],
      "@corespec/vite-plugin-api-auto-login": ["../../src/index.ts"]
    },
    "rootDir": "../..",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "mocks/**/*.ts", "vite.config.ts", "dev.ts"]
}
